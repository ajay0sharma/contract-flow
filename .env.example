# Copy to .env.local for local development.
# In Vercel: Project → Settings → Environment Variables (Production + Preview).

# --- Required ---

# Supabase Postgres. For Vercel/serverless, prefer the Supabase pooler (port 6543):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required on Vercel so Clerk accepts the deployment hostname
CLERK_TRUST_HOST=true

# Supabase Storage (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase URL (optional if DATABASE_URL is Supabase; auto-derived otherwise)
NEXT_PUBLIC_SUPABASE_URL=

# Production app URL for links in notifications (set to your Vercel domain)
NEXT_PUBLIC_APP_URL=

# Comma-separated admin emails (platform admin access)
ADMIN_EMAILS=

# Protects /api/cron/* routes. Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Clerk URLs (optional; defaults work with /login and /sign-up) ---

CLERK_SIGN_IN_URL=/login
CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Optional features ---

# OpenAI obligation scanning
OPENAI_API_KEY=
OPENAI_OBLIGATION_MODEL=gpt-4o-mini

# Anthropic obligation scanning (alternative)
ANTHROPIC_API_KEY=

# PO integration credential encryption (32+ char secret)
PO_ENCRYPTION_KEY=

# Email notifications webhook (global fallback when a client has no outbound webhook URL)
CONTRACT_EMAIL_WEBHOOK_URL=

# Poll each client's legal mailboxes via that client's Microsoft directory integration
CONTRACT_EMAIL_SYNC_ENABLED=true

# Global fallback for POST /api/webhooks/contract-email when a client has no webhook secret configured
CONTRACT_EMAIL_WEBHOOK_SECRET=

# Per-client email settings are stored in OrganizationEmailConfig and managed via:
# GET/PUT /api/admin/email-config?organizationId=<client-id>

# Error reporting
SENTRY_DSN=

# TLS override for Postgres (usually not needed with Supabase)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
