{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:deploy",
  "crons": [
    {
      "path": "/api/cron/directory-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/contract-email-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/contract-renewal-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/contract-approval-escalation",
      "schedule": "0 9 * * *"
    }
  ]
}
